agents.myalgodesk.in, shayak.myalgodesk.in {
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
    }
    request_body {
        max_size 524288
    }
    @clinic {
        host shayak.myalgodesk.in
        path /integrations/agent-platform/whatsapp /integrations/agent-platform/calling
    }
    handle @clinic {
        reverse_proxy 172.24.0.1:44001
    }
    # Service/gateway credentials are validated by the platform on every route.
    # No operator console or legacy unscoped API is exposed here.
    @appagents {
        host agents.myalgodesk.in
        path /v1/businesses/* /v1/integrations/* /v1/whatsapp/* /v1/telephony/* /v1/voice/agents /v1/voice/agents/* /v1/knowledge/documents /v1/knowledge/documents/*
    }
    handle @appagents {
        reverse_proxy agent-platform-api-1:4060
    }
    @businesspages {
        host agents.myalgodesk.in
        path /about /privacy /data-deletion /app-icon.png
    }
    handle @businesspages {
        reverse_proxy agent-platform-api-1:4060
    }
    @public path /voice/call /voice/assets/* /public/voice/* /webhooks/calling/* /webhooks/whatsapp/* /webhooks/meta /connect/whatsapp/* /connect/whatsapp-assets/*
    handle @public {
        reverse_proxy agent-platform-api-1:4060
    }
    handle / {
        respond "NRAIAlgo agent connection service. Customer onboarding is not yet public." 200
    }
    handle {
        respond 404
    }
}
