# Populate a private .env file. Never commit credentials.
# Only the exact value development enables /openapi.json. Default: hidden.
AI_PLATFORM_ENV=production
# Operator-only bootstrap. Runtime URLs are generated separately; never pass this to the API.
AGENT_DB_ADMIN_URL=postgresql://postgres:CHANGE_ME@db:5432/agent_platform
AGENT_DB_PASSWORD=CHANGE_ME
AI_PLATFORM_CONNECTOR_URL=
AI_PLATFORM_SIGNING_KEY=
AI_PLATFORM_NVIDIA_FAST_MODEL=
AI_PLATFORM_NVIDIA_REASONING_MODEL=
NVIDIA_API_KEY=
AI_NVIDIA=1
AI_BUILTIN_AGENTS=1
AI_CUSTOM_AGENTS=1
AI_MEMORY=1
AI_RAG=0
AI_WORKFLOWS=0
# Durable task API only. No browser/site adapters are installed yet.
AI_BROWSER_TASKS=0

# Reusable task-agent pilot (read-only decision comparison is the only bundled tool).
AI_DURABLE_TASKS=0
AI_TASK_AGENTS=0

# Optional image analysis, using the existing NVIDIA_API_KEY
AI_VISION=0
AI_PLATFORM_NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional inbound WhatsApp support. Operator-managed secrets; never commit real values.
# JSON keyed by Meta phone-number ID, each with app_id, access_token, app_secret,
# verify_token, and an explicitly selected supported graph_version (e.g. vXX.0).
AI_WHATSAPP_CONNECTIONS={}

# Public API origin used to display WhatsApp webhook URLs (does not create hosting/TLS).
AI_PLATFORM_PUBLIC_URL=
# Optional private JSON connection file. Local console launcher sets its own 0600 file.
# Production should use secret injection; never expose the local console publicly.
AI_WHATSAPP_CONNECTIONS_FILE=

# Meta Embedded Signup v4. App/configuration IDs are public; all other credentials stay server-only.
AI_META_APP_ID=
AI_META_CONFIGURATION_ID=
AI_META_GRAPH_VERSION=v26.0
AI_META_PUBLIC_URL=
AI_META_APP_SECRET=
AI_META_VERIFY_TOKEN=
# AES-256-GCM key ring: JSON mapping key IDs to base64-encoded 32-byte random keys.
# Keep retired keys while old ciphertext exists. Back up keys independently of the database.
AI_META_ENCRYPTION_KEY_ID=
AI_META_ENCRYPTION_KEYS={}

# Optional cross-provider fallback for explicit NVIDIA HTTP 429/503 only.
# Sends the same question and permitted evidence to this provider when enabled.
# Provider: openrouter, together, or gemini. Set an exact supported model ID and private API key.
AI_PLATFORM_FALLBACK_PROVIDER=
AI_PLATFORM_FALLBACK_MODEL=
AI_PLATFORM_FALLBACK_API_KEY=

# Optional multi-business Chakra signup. Requires partner entitlement and operator ownership checks.
# Do not reuse a customer-scoped Bot credential as a partner credential without authorization.
AI_CHAKRA_PARTNER_TOKEN=
AI_CHAKRA_WEBHOOK_SECRET=
AI_CHAKRA_GRAPH_VERSION=

# WhatsApp calling reuses the customer's authorized Meta/Chakra connection.
# Audio is processed by Gemini. Defaults off; install the optional voice extra.
AI_WHATSAPP_CALLING_ENABLED=0
AI_CALLING_AUDIO_API_KEY=
AI_CALLING_STT_MODEL=gemini-3.1-flash-lite
AI_CALLING_TTS_MODEL=gemini-2.5-flash-preview-tts
AI_CALLING_ICE_SERVERS=[]
# Optional signed app business handlers keyed by calling-agent ID. Operator-only.
AI_CALLING_APP_HANDLERS={}

# Internet voice (independent of WhatsApp); AI speech and hosting costs may apply.
AI_WEB_VOICE_ENABLED=0
AI_WEB_VOICE_MODEL=gemini-3.1-flash-lite
AI_WEB_VOICE_HANDLERS={}
AI_VOICE_ICE_SERVERS=[]

# Set only after the public HTTPS page and WebRTC network are verified.
AI_WEB_VOICE_PUBLIC_ORIGIN=
# Browser ICE configuration; use expiring TURN credentials in a public deployment.
AI_WEB_VOICE_BROWSER_ICE_SERVERS=[]

# Coturn REST shared secret: private, never included in browser responses.
AI_VOICE_TURN_SECRET=
AI_VOICE_TURN_URLS=[]

# Optional basic CPU speech on Gemini TTS 429/503; requires espeak-ng in the media image.
AI_VOICE_LOCAL_TTS_FALLBACK=0

# App-owned telephone tool endpoints. Exact origins are approved by the operator per app.
AI_TELEPHONY_TOOL_ORIGINS={}
# Platform handles speech; gateway configurations do not need AI keys.
# local requires espeak-ng (API Docker build INSTALL_VOICE=1); default is gemini.
AI_TELEPHONY_TTS_PROVIDER=gemini

# Optional speech provider for bounded voice turns; does not provision telephone numbers.
AI_CALLING_SPEECH_PROVIDER=gemini
AI_SARVAM_API_KEY=

# Optional local semantic memory. Install .[embeddings], download a model once,
# then use an immutable local directory and its revision (no runtime downloads).
AI_MEMORY_EMBEDDING_PATH=
AI_MEMORY_EMBEDDING_REVISION=
# Generic orchestration (uses the existing task worker)
AI_AUTOMATIONS=0
AI_MODEL_ROUTES={}
AI_MODEL_MAX_CONTEXT_BYTES=100000
AI_EVENT_WEBHOOK_DESTINATIONS={}

# Runtime roles: provision scripts/database_roles.py then scripts/runtime_env.py.
# Keep administrator/migrator credentials out of API/worker environment files.
# Optional explicit ordered chain. No paid route is enabled by default.
AI_MODEL_PROVIDER_CHAIN=
# Public Ed25519 keys only: issuer,kid,tenant,app_id,public_key,not_before,not_after.
AI_DELEGATION_ISSUER_KEYS=[]
# Epoch seconds. Set after NRAIAlgo migrates; empty preserves the legacy overlap.
AI_DELEGATION_LEGACY_UNTIL=

# Optional platform-to-NRAIAlgo connector migration; enable after receiver support.
AI_CONNECTOR_ISSUER_KEY_FILE=
AI_CONNECTOR_LEGACY_UNTIL=

# Transactional SMS: explicit opt-in; missing routes never fall back to mock.
AI_SMS_NOTIFICATIONS=0
AI_SMS_APPS={}
# Caps are segment reservations, including retries, across all configured SMS apps.
AI_SMS_GLOBAL_LIMITS={"daily":10,"monthly":100,"per_minute":5}
# Per-app key references and the shared notification encryption keyring: see docs/SMS.md.
