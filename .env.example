# Populate a private .env file. Never commit credentials.
AI_PLATFORM_DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/agent_platform
AGENT_DB_PASSWORD=CHANGE_ME
AI_PLATFORM_CONNECTOR_URL=
AI_PLATFORM_SIGNING_KEY=
AI_PLATFORM_NVIDIA_FAST_MODEL=
AI_PLATFORM_NVIDIA_REASONING_MODEL=
NVIDIA_API_KEY=
AI_NVIDIA=1
AI_BUILTIN_AGENTS=1
AI_CUSTOM_AGENTS=1
AI_MEMORY=1
AI_RAG=0
AI_WORKFLOWS=0
# Durable task API only. No browser/site adapters are installed yet.
AI_BROWSER_TASKS=0

# Reusable task-agent pilot (read-only decision comparison is the only bundled tool).
AI_DURABLE_TASKS=0
AI_TASK_AGENTS=0

# Optional image analysis, using the existing NVIDIA_API_KEY
AI_VISION=0
AI_PLATFORM_NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional inbound WhatsApp support. Operator-managed secrets; never commit real values.
# JSON keyed by Meta phone-number ID, each with app_id, access_token, app_secret,
# verify_token, and an explicitly selected supported graph_version (e.g. vXX.0).
AI_WHATSAPP_CONNECTIONS={}

# Public API origin used to display WhatsApp webhook URLs (does not create hosting/TLS).
AI_PLATFORM_PUBLIC_URL=
# Optional private JSON connection file. Local console launcher sets its own 0600 file.
# Production should use secret injection; never expose the local console publicly.
AI_WHATSAPP_CONNECTIONS_FILE=

# Meta Embedded Signup v4. App/configuration IDs are public; all other credentials stay server-only.
AI_META_APP_ID=
AI_META_CONFIGURATION_ID=
AI_META_GRAPH_VERSION=v26.0
AI_META_PUBLIC_URL=
AI_META_APP_SECRET=
AI_META_VERIFY_TOKEN=
# AES-256-GCM key ring: JSON mapping key IDs to base64-encoded 32-byte random keys.
# Keep retired keys while old ciphertext exists. Back up keys independently of the database.
AI_META_ENCRYPTION_KEY_ID=
AI_META_ENCRYPTION_KEYS={}

# Optional cross-provider fallback for explicit NVIDIA HTTP 429/503 only.
# Sends the same question and permitted evidence to this provider when enabled.
# Provider: openrouter, together, or gemini. Set an exact supported model ID and private API key.
AI_PLATFORM_FALLBACK_PROVIDER=
AI_PLATFORM_FALLBACK_MODEL=
AI_PLATFORM_FALLBACK_API_KEY=

# Optional multi-business Chakra signup. Requires partner entitlement and operator ownership checks.
# Do not reuse a customer-scoped Bot credential as a partner credential without authorization.
AI_CHAKRA_PARTNER_TOKEN=
AI_CHAKRA_WEBHOOK_SECRET=
AI_CHAKRA_GRAPH_VERSION=

# Calling: private operator registry; see docs/CALLING_AGENTS.md.
# Never put provider tokens in browser code. Empty registry keeps live calls disabled.
AI_CALLING_CONNECTIONS={}
