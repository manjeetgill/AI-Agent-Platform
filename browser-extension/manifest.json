{
  "manifest_version": 3,
  "name": "Agent Workspace Browser Runner",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Prepare approved searches and read product evidence on explicitly allowed retailer sites. No purchases or secrets.",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:4061/*",
    "https://www.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wikipedia.org/*"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:4060/*",
    "https://www.croma.com/*",
    "https://www.jiomart.com/*",
    "https://www.zepto.com/*",
    "https://instamart.in/*"
  ]
}
